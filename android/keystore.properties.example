# Copie ce fichier vers android/keystore.properties (non versionné).
# Génère le keystore :
#   keytool -genkey -v -keystore talk-foot-release.keystore -alias talkfoot -keyalg RSA -keysize 2048 -validity 10000
storeFile=../talk-foot-release.keystore
storePassword=REMPLACER
keyAlias=talkfoot
keyPassword=REMPLACER
