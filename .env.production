# Domaine DNS public (sans slash final) — injecté au build pour sitemap, robots, og:url, canonical.
VITE_PUBLIC_SITE_URL=https://talk-foot.com

# Capacitor (Android/iOS) : relais SportMonks via https://talk-foot.com/api/sm — aucune clé dans le bundle.
VITE_SPORTMONKS_RELAY_ONLY=true

# AdSense — slot par défaut réservé aux emplacements accueil (home-*). Pas sur les rails des autres pages.
VITE_ADSENSE_CLIENT=ca-pub-2366855551945752
VITE_ADSENSE_SLOT_DEFAULT=6503560713
