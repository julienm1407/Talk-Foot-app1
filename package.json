{
  "name": "talk-foot-appli",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && GITHUB_PAGES=true vite build",
    "lint": "eslint .",
    "diag:bookmakers": "node scripts/diagnose-bookmakers.mjs",
    "preview": "vite preview",
    "preview:pages": "vite preview --base /Talk-Foot-app1/ --outDir docs",
    "test:avatar-zones": "npx tsx --test src/components/profile/avatarHeadZones.test.ts",
    "test:odds": "npx tsx --test src/odds/internalOddsEngine.test.ts src/odds/exactScoreOdds.test.ts",
    "audit:odds": "npx tsx scripts/audit-prematch-odds.mjs",
    "test:mascot": "npx vite-node --test src/components/mascot/mascotGallery.test.ts src/components/mascot/mascotAnchorRandom.test.ts src/components/mascot/hair/hairAssetParser.test.ts",
    "boutique:assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/import-boutique-design-assets.ps1; powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-boutique-kit-images.ps1",
    "auth:email-templates": "node scripts/apply-auth-email-templates.mjs",
    "build:mobile": "npm run build && npx cap sync",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:assets": "npx capacitor-assets generate --assetPath mobile/assets --iconBackgroundColor \"#ffffff\" --iconBackgroundColorDark \"#061222\" --splashBackgroundColor \"#061222\" --splashBackgroundColorDark \"#061222\"",
    "android:release": "npm run build:mobile && cd android && gradlew.bat bundleRelease",
    "android:debug": "npm run build:mobile && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@clerk/clerk-react": "^5.61.6",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@rive-app/react-canvas": "^4.28.4",
    "@supabase/supabase-js": "^2.49.1",
    "dompurify": "^3.4.8",
    "framer-motion": "^12.38.0",
    "marked": "^18.0.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "stripe": "^18.5.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0"
  }
}
